# ==========================================
# Global / OS-specific (ملفات النظام العامة)
# ==========================================
.DS_Store
Thumbs.db
.idea/
.vscode/

# ==========================================
# أسرار البيئة (أي مستوى في المشروع)
# ==========================================
.env
.env.*
!.env.example
!.env.example.prod

# بايثون: التجميع المؤقت في أي مجلد فرعي
__pycache__/
*.py[cod]
*$py.class

# ==========================================
# Vue Frontend (مجلد الواجهة الأمامية)
# ==========================================
# Dependencies
frontend/node_modules/

# Production build artifacts
frontend/dist/
frontend/dist-ssr/

# Local environment variables
frontend/.env.local
frontend/.env.*.local

# Log files
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# ==========================================
# FastAPI Backend (مجلد الواجهة الخلفية)
# ==========================================
backend/uploads/*
!backend/uploads/.gitkeep
.mypy_cache/
.ruff_cache/

# Virtual Environments (البيئات الافتراضية)
backend/.venv/
backend/venv/
backend/env/
backend/ENV/

backend/secrets.json

# Testing / Coverage
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/

# Databases (قواعد البيانات المحلية)
backend/*.db
backend/*.sqlite3