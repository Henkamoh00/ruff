# ==========================================
# Global / OS-specific (ملفات النظام العامة)
# ==========================================
.DS_Store
Thumbs.db
.idea/
.vscode/

# ==========================================
# Vue Frontend (مجلد الواجهة الأمامية)
# ==========================================
# Dependencies
frontend/node_modules/

# Production build artifacts
frontend/dist/
frontend/dist-ssr/

# Local environment variables
frontend/.env.local
frontend/.env.*.local

# Log files
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# ==========================================
# FastAPI Backend (مجلد الواجهة الخلفية)
# ==========================================
# Byte-compiled / optimized files
backend/__pycache__/
backend/*.py[cod]
backend/*$py.class
backend/uploads/*
!backend/uploads/.gitkeep
.mypy_cache/
.ruff_cache/

# Virtual Environments (البيئات الافتراضية)
backend/.venv/
backend/venv/
backend/env/
backend/ENV/

# Environment variables & Secrets (ملفات المتغيرات السرية)
backend/.env
backend/.env.*
!backend/.env.example
!backend/.env.example.prod
backend/secrets.json

# Testing / Coverage
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/

# Databases (قواعد البيانات المحلية في حال استخدام SQLite)
backend/*.db
backend/*.sqlite3
