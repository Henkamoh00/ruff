# نسخة الإنتاج لملف compose. انسخها على الخادم فقط إلى .env ولا ترفع .env إلى Git.
# ولّد كل قيمة بـ: python -c "import secrets; print(secrets.token_hex(32))"
# صيغة hex مقصودة: لا تحتوي رموزًا تكسر عنوان الاتصال داخل DATABASE_URL.

# اسم مستخدم مختلف عن التطوير، كي لا يخمّنه من يعرف إعدادات التطوير.
POSTGRES_USER=raff_app

# اسم قاعدة البيانات. يجب أن يطابق الاسم داخل DATABASE_URL في backend/.env.
POSTGRES_DB=raff

# كلمة مرور جديدة تمامًا، لا تعيد استخدام كلمة مرور التطوير.
# يجب أن تطابق الكلمة داخل DATABASE_URL في backend/.env.
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# كلمة مرور Redis مستقلة عن PostgreSQL وعن التطوير.
# يجب أن تطابق الكلمة داخل REDIS_URL في backend/.env.
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD