# انسخه إلى backend/.env واستبدل كل قيمة CHANGE_ME بقيمة مولدة محليًا.
# التطبيق يرفض الإقلاع إذا بقيت أي قيمة CHANGE_ME أو كان سر أقصر من 32 حرفًا.

APP_ENV=development
LOG_LEVEL=INFO
ENABLE_DOCS=true

# كلمة المرور هنا يجب أن تطابق POSTGRES_PASSWORD في .env بالجذر
DATABASE_URL=postgresql+psycopg://raff:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/raff

# كلمة المرور هنا يجب أن تطابق REDIS_PASSWORD في .env بالجذر
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@127.0.0.1:6379/0

# سران مستقلان، كل منهما 32 حرفًا على الأقل
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET
CSRF_SECRET_KEY=CHANGE_ME_CSRF_SECRET