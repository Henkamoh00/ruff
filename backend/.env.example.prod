# نسخة الإنتاج. انسخها على الخادم فقط إلى backend/.env ولا ترفع .env إلى Git.
# ولّد كل سر بـ: python -c "import secrets; print(secrets.token_hex(32))"
# التطبيق يرفض الإقلاع إذا بقيت أي قيمة CHANGE_ME أو كان سر أقصر من 32 بايت.

# يفعّل قواعد الإنتاج، ويمنع تفعيل صفحات الوثائق.
APP_ENV=production

# INFO يكفي للتشغيل العادي. لا تستخدم DEBUG في الإنتاج لأنه قد يسجّل تفاصيل حساسة.
LOG_LEVEL=INFO

# يجب أن تبقى false. التطبيق يرفض الإقلاع في الإنتاج إذا كانت true،
# لأن /docs يكشف بنية الـ API للعامة.
ENABLE_DOCS=false

# المستخدم وكلمة المرور واسم القاعدة يطابقون POSTGRES_* في .env بالجذر.
# المضيف 127.0.0.1 إذا كان التطبيق يعمل على الخادم نفسه ومنفذ PostgreSQL مربوطًا محليًا.
# إن شُغّل التطبيق داخل حاوية، غيّر المضيف إلى اسم خدمة Docker وهو postgres.
# لا تفتح PostgreSQL للإنترنت إطلاقًا.
DATABASE_URL=postgresql+psycopg://raff_app:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/raff

# كلمة المرور تطابق REDIS_PASSWORD في .env بالجذر. نفس ملاحظة المضيف أعلاه، واسم الخدمة redis.
# إن استخدمت Redis عن بُعد عبر TLS فاستعمل rediss:// بدل redis://.
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@127.0.0.1:6379/0

# سر توقيع رموز الدخول. 32 بايت على الأقل، ومختلف عن سر التطوير.
# تدويره يُخرج جميع المستخدمين من جلساتهم، فغيّره فقط عند الحاجة أو عند الاشتباه بتسرّبه.
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET

# سر توقيع رمز CSRF. يجب أن يكون مختلفًا عن JWT_SECRET_KEY،
# كي لا يؤدي كشف أحدهما إلى كسر الحماية الأخرى.
CSRF_SECRET_KEY=CHANGE_ME_CSRF_SECRET